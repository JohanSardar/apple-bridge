<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>ABWidgetKeychainGroup</key><string>$(AppIdentifierPrefix)com.johansardar.applebridge.ios.widgetstatus</string>
    <key>ABApproved_wallet</key><false/>
    <key>ABApproved_criticalAlerts</key><false/>
    <key>ABApproved_locationPush</key><false/>
    <key>ABApproved_fallDetection</key><false/>
    <key>ABLocationPushAppGroup</key><string></string>
    <key>NSFinancialDataUsageDescription</key><string>Share only financial accounts and transactions you authorize with your paired gateway.</string>
	<key>ABJournalGranted</key>
	<false/>
	<key>ABEnergyGranted</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>Apple Bridge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Log water, weight, mindful minutes and workouts you request.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Capture your selected Health samples and summaries for your paired Apple Bridge gateway.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMotionUsageDescription</key>
	<string>Read activity, steps and floors for your motion automations.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSAlarmKitUsageDescription</key>
	<string>Schedule alarms and timers requested through Apple Bridge.</string>
	<key>NFCReaderUsageDescription</key>
	<string>Read NFC tags for your automations.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Read your precise location on request and access your current Wi-Fi network for home automations.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Record enabled location events and refresh location for owner-requested location pushes while sharing is enabled.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan your Apple Bridge gateway pairing code.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your Apple Bridge gateway on the local network.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Authenticate approval or rejection of agent commands.</string>
</dict>
</plist>
