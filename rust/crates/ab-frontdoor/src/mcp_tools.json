  {
    "name": "messages_read",
    "title": "Read messages",
    "scope": "messages:read",
    "description": "List recent chats, read a thread or search message text.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "with": {
          "type": "string",
          "description": "Phone number, email or contact name of the other person."
        },
        "chat_id": {
          "type": "string",
          "description": "A cht_ chat ID from an earlier result."
        },
        "text": {
          "type": "string",
          "description": "Words to find in messages, across all chats. Not with with or chat_id."
        },
        "unread": {
          "type": "boolean",
          "description": "Only unread chats or messages; in a chat, start at the first unread message."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum chats or messages. Default 20."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "From page.next."
        },
        "senders": {
          "type": "string",
          "enum": [
            "known",
            "all"
          ],
          "description": "Chat lists: all adds spam, unknown senders and old unread."
        },
        "before": {
          "type": "string",
          "description": "In a chat: the before value from the previous result, for older messages."
        },
        "after": {
          "type": "string",
          "description": "For text results: the after value from the previous result."
        }
      }
    },
    "outputSchema": {
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "example": {
      "with": "Ana Novak"
    },
    "effect": "read"
  },
  {
    "name": "messages_send",
    "title": "Send a message",
    "scope": "messages:write",
    "description": "Send a message with text, photos or both.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "description": "Phone number in international form, email, or a contact's name."
        },
        "chat_id": {
          "type": "string",
          "description": "An existing chat's cht_ ID. Use instead of to."
        },
        "text": {
          "type": "string",
          "description": "Message text, sent exactly as given. Optional with photos."
        },
        "photos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string"
          },
          "description": "asset_ids from photos_find; attaches the photo files."
        },
        "service": {
          "type": "string",
          "enum": [
            "iMessage",
            "SMS",
            "RCS"
          ],
          "description": "Only for a number or email without an existing chat. Default iMessage."
        },
        "request_id": {
          "type": "string",
          "description": "Reuse this ID only with the same request."
        }
      }
    },
    "outputSchema": {
      "$ref": "#change"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "example": {
      "to": "Ana Novak",
      "text": "On my way"
    },
    "effect": "write"
  },
