  {
    "name": "apple_search",
    "title": "Search Apple data",
    "description": "Search readable sources for text. The result reports sources skipped or with more matches.",
    "inputSchema": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Words to find."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only these sources, such as notes, mail, calendar or messages, or a collection such as notes.note. Default all you can read."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Matches per source. Default 5."
        },
        "after": {
          "type": "string",
          "description": "A source's value from more, for its next page; set sources to that one source."
        }
      }
    },
    "outputSchema": {
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "example": {
      "text": "passport",
      "sources": [
        "notes",
        "mail"
      ]
    },
    "effect": "read"
  },
  {
    "name": "apple_read",
    "title": "Read Apple data",
    "description": "Run a read or a batch of up to 10 reads. Get arguments from apple_describe.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "description": "Read operation name."
        },
        "arguments": {
          "type": "object",
          "description": "Its arguments."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keep only these data fields in each record."
        },
        "reads": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "description": "A name from operation."
              },
              "arguments": {
                "type": "object",
                "description": "Its arguments."
              }
            },
            "required": [
              "operation"
            ]
          },
          "description": "Instead of operation: up to 10 reads, results in order."
        },
        "request_id": {
          "type": "string",
          "description": "For reads the owner must approve: repeat with the same request_id after approval."
        },
        "verbose": {
          "type": "boolean",
          "description": "The full result with sync details."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "From page.next."
        },
        "view": {
          "type": "string",
          "enum": [
            "due_today",
            "overdue",
            "upcoming"
          ],
          "description": "reminders.list smart today: one group in full."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "page": {
          "type": "object"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "result": {
                "type": "object"
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ]
              }
            },
            "required": [
              "operation"
            ]
          }
        },
        "failed": {
          "type": "integer"
        },
        "next": {
          "type": "string"
        },
        "cut": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code"
          ]
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "example": {
      "operation": "reminders.list",
      "arguments": {
        "smart": "today"
      }
    },
    "effect": "read"
  },
  {
    "name": "apple_change",
    "title": "Change Apple data",
    "description": "Run a change. Get its arguments from apple_describe.",
    "inputSchema": {
      "type": "object",
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "description": "Operation name."
        },
        "arguments": {
          "type": "object",
          "description": "Its arguments, with expected_version where needed."
        },
        "request_id": {
          "type": "string",
          "description": "Reuse this ID only with the same request."
        },
        "verbose": {
          "type": "boolean",
          "description": "Include the full history and the Mac's raw result."
        }
      }
    },
    "outputSchema": {
      "$ref": "#change"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "example": {
      "operation": "reminders.complete",
      "arguments": {
        "reminder": "Call the plumber"
      }
    },
    "effect": "write"
  },
  {
