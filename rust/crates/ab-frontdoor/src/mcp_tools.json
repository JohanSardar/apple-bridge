  {
    "name": "photos_find",
    "title": "Find photos",
    "scope": "photos:read",
    "description": "Find photo assets with individual previews, or browse by place.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "description": "Taken on or after, RFC 3339 or YYYY-MM-DD."
        },
        "end": {
          "type": "string",
          "description": "Taken before, RFC 3339 or YYYY-MM-DD."
        },
        "type": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "live_photo",
            "screenshot",
            "panorama",
            "hdr",
            "depth",
            "slow_motion",
            "timelapse"
