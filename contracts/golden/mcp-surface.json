  "tools": [
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Shows your access (level and scopes), which Apple sources are ready, and the Mac's time zone and time. Not needed before other calls; use it when a source is empty or refused. Reads nothing private.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "apple_status",
      "outputSchema": {
        "properties": {
          "access": {
            "type": "object"
          },
          "next": {
            "type": "string"
          },
          "now": {
            "type": "string"
          },
          "sources": {
            "type": "array"
          },
          "time_zone": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Apple Bridge status"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Look up what you can do; no Apple data is touched. query: the best operations for a task in plain words, such as screen time yesterday or get voicemail, best first. operation: its exact arguments, an example call, the access it needs and what it returns. domain: that domain's operations. No arguments: every operation, one line each.",
      "inputSchema": {
        "properties": {
          "domain": {
            "description": "Domain name, such as reminders or messages.",
            "type": "string"
          },
          "operation": {
            "description": "Operation name, such as reminders.create.",
            "type": "string"
          },
          "query": {
            "description": "The task in plain words.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "apple_describe",
      "outputSchema": {
        "properties": {
          "arguments": {
            "type": "object"
          },
          "example": {
            "type": "object"
          },
          "next": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "operations": {
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "title": "Find operations"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search the owner's data for text in one call: contacts, messages, notes, mail, reminders, calendar, files, Safari, voicemail and other synced records. Returns matches grouped by source with ids, which sources have more, and which were not searched. Photos have no text search: use photos.search with apple_read.",
      "inputSchema": {
        "properties": {
          "after": {
            "description": "The after value a source returned in more, to get its next page. Use with sources set to that one source.",
            "type": "string"
          },
          "limit": {
            "description": "Matches per source. Default 10.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "sources": {
            "description": "Only these sources, such as notes, mail, calendar or messages, or a collection such as notes.note. Default all you can read.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "text": {
            "description": "Words to find.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "name": "apple_search",
      "outputSchema": {
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "more": {
            "type": "object"
          },
          "next": {
            "type": "string"
          },
          "results": {
            "type": "object"
          },
          "skipped": {
            "type": "object"
          }
        },
        "type": "object"
      },
      "title": "Search Apple data"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Run any read operation; reads never change anything. Common reads need no lookup, arguments optional: reminders.lists {}; reminders.items {\"list\":\"Groceries\"} or {\"smart\":\"today\"}; notes.list {}; one record by id: records.get {\"id\":\"nte_…\"}. For others, apple_describe gives the arguments. Records carry id and version: use the id in later calls and the version as expected_version when changing that record. Paging: pass next back as after, or next_cursor as cursor for Photos. reads runs up to 10 reads in one call.",
      "inputSchema": {
        "properties": {
          "arguments": {
            "description": "The operation's arguments, as apple_describe lists them.",
            "type": "object"
          },
          "fields": {
            "description": "Keep only these data fields in each record, such as title and due.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "operation": {
            "description": "Read operation name, such as reminders.items.",
            "type": "string"
          },
          "reads": {
            "description": "Instead of operation: up to 10 reads to run together. Each result or error comes back in results, in order.",
            "items": {
              "properties": {
                "arguments": {
                  "description": "Its arguments.",
                  "type": "object"
                },
                "operation": {
                  "description": "Read operation name.",
                  "type": "string"
                }
              },
              "required": [
                "operation"
              ],
              "type": "object"
            },
            "maxItems": 10,
            "type": "array"
          },
          "request_id": {
            "description": "Only for reads the owner must approve, such as location.current: repeat the call with the same request_id after approval.",
            "type": "string"
          },
          "verbose": {
            "description": "Return the full result with coverage and sync details. Default false.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "apple_read",
      "outputSchema": {
        "type": "object"
      },
      "title": "Read Apple data"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Run any operation that changes data, such as calendar.update_event or reminders.complete; get its arguments from apple_describe. Waits up to 15 seconds and returns status: done (with ids and the changed record), partial (some parts happened: see parts), pending, awaiting_approval, failed or indeterminate. Updates and deletes need expected_version, the record's version from your read. Repeating the same request_id never acts twice; never repeat partial or indeterminate with a new one.",
      "inputSchema": {
        "properties": {
          "arguments": {
            "description": "The operation's arguments, including expected_version where needed.",
            "type": "object"
          },
          "operation": {
            "description": "Operation name, such as reminders.complete.",
            "type": "string"
          },
          "request_id": {
            "description": "Your ID for this change, letters, digits and ._:- up to 120 characters. Reuse it to retry safely. Default: a new one.",
            "type": "string"
          },
          "verbose": {
            "description": "Include the full history and the Mac's raw result. Default false.",
            "type": "boolean"
          }
        },
        "required": [
          "operation"
        ],
        "type": "object"
      },
      "name": "apple_change",
      "outputSchema": {
        "properties": {
          "ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "next": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "parts": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "record": {
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "done",
              "partial",
              "pending",
              "awaiting_approval",
              "failed",
              "indeterminate"
            ],
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Change Apple data"
    },
